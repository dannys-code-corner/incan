"""
Demonstrates public visibility on models and functions.

## Notes
- `pub model` implies public fields by default.
- The contextual `private` modifier keeps selected fields type-private.
"""

pub model Point:
    x: int
    y: int
    private secret: int = 0

    def secret_value(self) -> int:
        return self.secret

pub def origin() -> Point:
    return Point(x=0, y=0)

def length_squared(p: Point) -> int:
    return p.x * p.x + p.y * p.y

pub def demo() -> int:
    p = origin()
    return length_squared(p) + p.secret_value()
