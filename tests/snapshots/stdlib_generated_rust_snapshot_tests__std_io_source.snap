fn __incan_v1_00000000000000000000000000000000000e5f727573745f696f5f6572726f7200000000000000007a970000000000007cc6(
    operation: String,
    position: i64,
    detail: String,
) -> IoError {
    let _ = "\n    Convert host I/O error text into a `std.io` error.\n    ";
    if incan_stdlib::strings::str_contains(&detail, &"invalid") {
        return IoError {
            kind: "invalid_input".to_string(),
            detail: detail.to_string(),
            operation: operation.to_string(),
            position: position,
            path: None::<_>,
        };
    } else {
        if incan_stdlib::strings::str_contains(&detail, &"failed to fill whole buffer")
            || incan_stdlib::strings::str_contains(&detail, &"early eof")
        {
            return IoError {
                kind: "unexpected_eof".to_string(),
                detail: detail.to_string(),
                operation: operation.to_string(),
                position: position,
                path: None::<_>,
            };
        }
    }
    return IoError {
        kind: "other".to_string(),
        detail: detail,
        operation: operation,
        position: position,
        path: None::<_>,
    };
}
